  m_Name: 
  m_EditorClassIdentifier: Unity.Robotics.UrdfImporter::Unity.Robotics.UrdfImporter.UrdfPlugin
  PluginText: "<gazebo reference=\"lidar_link\">\n  <sensor type=\"ray\" name=\"lidar\">\n   
    <update_rate>10</update_rate>\n    <ray>\n      <scan>\n        <horizontal>\n         
    <samples>360</samples>\n          <min_angle>-3.14159</min_angle>\n         
    <max_angle>3.14159</max_angle>\n        </horizontal>\n      </scan>\n      <range>\n       
    <min>0.15</min>\n        <max>12.0</max>\n        <resolution>0.01</resolution>\n     
    </range>\n    </ray>\n  </sensor>\n</gazebo>"
