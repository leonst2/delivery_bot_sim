    <horizontal_fov>2.06</horizontal_fov>\n      <image>\n        <width>1920</width>\n       
    <height>1080</height>\n      </image>\n      <clip>\n        <near>0.05</near>\n       
    <far>50</far>\n      </clip>\n    </camera>\n  </sensor>\n</gazebo>"
